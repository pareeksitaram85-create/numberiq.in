# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Client financial data must never be served as a static file.
# public/ is deployed verbatim, so anything here is world-readable with no auth
# - gst_reco_master_data.json held real vendor GSTINs and 24 crore of tax.
# Module data belongs in Supabase behind RLS. See public/js/gst-reco-gate.js.
public/data/

# Local dev tooling (launch configs, session settings) - machine specific.
.claude/
